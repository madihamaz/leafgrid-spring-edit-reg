# Supabase project URL and anon (publishable) key — safe for the browser,
# reads are gated by RLS policies in supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — bypasses RLS. Server-side only, never expose to
# the browser. Used by API routes for registration writes and admin reads.
SUPABASE_SERVICE_ROLE_KEY=

# Google Apps Script Web App URL that receives registration submissions.
# Temporary: will be removed once registrations write to Supabase directly.
NEXT_PUBLIC_APPSCRIPT_URL=

# Razorpay publishable Key ID (test or live) used for client-side checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=
